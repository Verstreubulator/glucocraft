# The secrets the example panel configurations read with !secret. Copy this file to secrets.yaml in your
# ESPHome configuration folder and replace every value; secrets.yaml is never published or committed.
# Each panel needs wifi_ssid, wifi_password, glucocraft_panel_webhook_id and its own api_key and ap_password
# (the names in the header of its configuration).

glucocraft_guition_35_ap_password: "REPLACE with a password of 8 or more characters for the fallback access point"
glucocraft_guition_35_api_key: "REPLACE with a new 32-byte base64 key (the ESPHome Device Builder suggests one); also the OTA key"
glucocraft_panel_ap_password: "REPLACE with a password of 8 or more characters for the fallback access point"
glucocraft_panel_api_key: "REPLACE with a new 32-byte base64 key (the ESPHome Device Builder suggests one); also the OTA key"
glucocraft_panel_webhook_id: "REPLACE with the id of the wall-panel address shown on GlucoCraft's Display card and wall panels screen"
glucocraft_waveshare_lcd5_ap_password: "REPLACE with a password of 8 or more characters for the fallback access point"
glucocraft_waveshare_lcd5_api_key: "REPLACE with a new 32-byte base64 key (the ESPHome Device Builder suggests one); also the OTA key"
glucocraft_waveshare_lcd7_ap_password: "REPLACE with a password of 8 or more characters for the fallback access point"
glucocraft_waveshare_lcd7_api_key: "REPLACE with a new 32-byte base64 key (the ESPHome Device Builder suggests one); also the OTA key"
glucocraft_waveshare_p4_7b_ap_password: "REPLACE with a password of 8 or more characters for the fallback access point"
glucocraft_waveshare_p4_7b_api_key: "REPLACE with a new 32-byte base64 key (the ESPHome Device Builder suggests one); also the OTA key"
wifi_password: "REPLACE with the password of your Wi-Fi network"
wifi_ssid: "REPLACE with the name of your Wi-Fi network"
